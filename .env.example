# Development: localhost for web; 10.0.2.2 for Android emulator;
# use the development PC's Wi-Fi LAN IP for a physical device.
APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8000

# Public web Firebase configuration from the EXISTING ZAWANA project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Native Firebase files and identifiers registered in the same project.
# Use EAS file environment variables for cloud builds or ignored local files.
FIREBASE_ANDROID_CONFIG=
FIREBASE_IOS_CONFIG=
ANDROID_PACKAGE=
IOS_BUNDLE_IDENTIFIER=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# No Firebase Admin private keys, Google client secrets or Apple signing secrets belong here.
